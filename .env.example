SFL_API_KEY=
SFL_API_KEY_DEV=

# Vite-only dev (`npm run dev:vite`): proxy /api/* (default beta.d1g.uk)
# VITE_API_PROXY_TARGET=https://beta.d1g.uk
# VITE_API_PROXY_TARGET=http://localhost:8888

# Dig-day + hub-auth proxy → SFL Digging Hub (set in Netlify site env, not Vite)
HUB_API_BASE=https://beta.api.d1g.uk
HUB_WRITE_SECRET=

# Hub must expose /v1/auth/* (Google OAuth, email OTP, /me). No passwords.

# ProjectMate guest widget — minimum host requirement is just the embed config
# in code (projectId + Worker endpoint, see src/utils/chatWidgetLoader.js).
# No Netlify env needed: the host talks straight to the Worker, and the owner
# passphrase is typed at the #owner unlock prompt, never stored.
# Optional overrides:
# VITE_PROJECTMATE_ISSUES_ENDPOINT=https://projectmate-issues-api.jovyllebermudez.workers.dev
# (Optional hardening: same-origin proxy via netlify/functions/projectmate-feedback
#  + VITE_PROJECTMATE_ISSUES_ENDPOINT=/api/projectmate — needs
#  PROJECTMATE_WORKER_URL + PROJECTMATE_ADMIN_KEY in Netlify site env.)
# Local dev loopback: live https overlay can't fetch localhost APIs (Chrome
# blocks public→loopback), so point the overlay at a local dev server:
#   npx vite --port 5174 --host 127.0.0.1 --strictPort  (in projectmate overlay-app)
# VITE_PROJECTMATE_APP_URL=http://localhost:5174/
# Functions server for `npm run dev:vite` (default http://localhost:8888):
# VITE_NETLIFY_DEV_URL=http://localhost:8899

# Optional: hub replay UI base for link fallback if API returns id only (Vite build)
# VITE_HUB_UI_BASE=https://beta.hub.d1g.uk